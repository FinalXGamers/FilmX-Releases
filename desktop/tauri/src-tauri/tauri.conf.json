{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilmX",
  "version": "1.0.2",
  "identifier": "com.finalxgamers.filmx.desktop",
  "build": {
    "frontendDist": "../landing"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "FinalXGamers",
    "shortDescription": "FilmX desktop app",
    "longDescription": "FilmX desktop app. Requires an internet connection.",
    "category": "Entertainment",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "FilmX"
      }
    }
  }
}
